# PLAN EXAMPLE ONLY. Not authorization to create or reset a database.
# Copy to the separately guarded backend environment during implementation.
# Credentials/absolute paths must be supplied for the actual installation.
APP_NAME=Tarjetas
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tarjetas-integration.test
FRONTEND_URL=https://app.tarjetas-integration.test
CORS_ALLOWED_ORIGINS=https://app.tarjetas-integration.test
SANCTUM_STATEFUL_DOMAINS=app.tarjetas-integration.test

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tarjetas_integration_disposable
DB_USERNAME=tarjetas_integration_test
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=tarjetas_integration_session
SESSION_DOMAIN=.tarjetas-integration.test
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

TARJETAS_DOCUMENT_ROOT=
TARJETAS_REFERENCE_DIR=
TARJETAS_PYTHON=
TARJETAS_PDF_SCRIPT=
TARJETAS_OCR_SCRIPT=
TARJETAS_NODE_HELPER=
ACCOUNTING_APP_REVISION=
ANTHROPIC_API_KEY=

# Custom guard variables require explicit config mappings; blank means refuse.
TARJETAS_TEST_TARGET_ID=
TARJETAS_TEST_TARGET_REGISTRY=
TARJETAS_TEST_TEMP_ROOT=
