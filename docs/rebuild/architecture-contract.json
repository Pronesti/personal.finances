    },
    {
      "id": "user-b",
      "email": "synthetic-b@example.invalid",
      "ledger_id": "22222222-2222-4222-8222-222222222222"
    }
  ],
  "required_acceptance": [
    "independent_builds",
    "frontend_health_http",
    "sanctum_login_reload_logout",
    "csrf_rejection_and_success",
    "credentialed_cors_and_preflight",
    "two_user_read_write_document_isolation",
    "database_cross_ledger_reference_rejection",
    "cache_job_replay_isolation",
    "per_owner_financial_fixtures",
    "all_financial_spa_routes",
    "owner_aware_restore",
    "production_domain_auth_smoke",
    "health_without_session_or_database",
    "pdf_button_blob_auth_and_fallback",
    "disposable_postgres_guard_refusals",
    "http_upload_boundaries_and_bounded_processing",
    "database_fk_exclusive_key_sqlstate_23503",
    "buffered_upload_and_queue_share_ingress_deadline",
    "client_deadline_spoofing_rejected",
    "development_and_test_cookie_domains_disjoint"
  ],
  "known_deployment_dependency": "Private macOS Vision processing runtime; Linux-only API hosting needs an explicitly designed private adapter",
  "document_viewer": {
    "transport": "credentialed_spa_blob_fetch",
    "direct_api_new_tab": false,
    "popup_blocked_fallback": "second_click_blob_link",
    "expire_clears_cached_bytes": true
  },
  "recovery": {
    "format": "tarjetas-owned-recovery-v2",
    "reference_identity": [
      "ledger_id",
      "kind",
      "reference_id"
    ],
    "owner_qualified_paths": true,
    "identity_component": "separate_encrypted_users_password_hashes_and_ledger_mapping",
    "sessions_included": false,
    "remember_tokens_cleared": true,
    "legacy_backup_compatible_unchanged": false
  },
  "test_safety": {
    "driver": "pgsql",
    "integration_environment": "testing",
    "browser_environment": "browser-testing",
    "guard_before_destructive_hooks": true,
    "approved_target_registry_required": true,
    "protected_database_marker_required": true,
    "resolved_config_checked": true,
    "cached_config_rejected": true,
    "browser_csrf_enabled": true,
    "development_target_allowed": false,
    "cookie_domains_disjoint_from_other_environments": true
  },
  "upload_limits": {
    "statement_file_bytes": 10485760,
    "receipt_file_bytes": 41943040,
    "multipart_overhead_bytes": 1048576,
    "php_upload_max_filesize_bytes": 41943040,
    "php_post_max_size_bytes": 50331648,
    "ingress_body_max_bytes": 50331648,
    "file_over_limit_status": 400,
    "body_over_limit_status": 413
  },
  "timeouts": {
    "upload_max_seconds": 180,
    "request_wall_clock_seconds": 720,
    "ocr_attempt_max_seconds": 180,
    "ocr_attempts_max": 3,
    "non_ocr_total_max_seconds": 180,
    "fpm_terminate_seconds": 750,
    "upstream_read_seconds": 780,
    "edge_response_wait_seconds": 800,
    "spa_import_timeout_ms": 1000000,
    "deadline_includes_intake": true
  },
  "test_environments": {
    "integration": {
      "api_origin": "https://api.tarjetas-integration.test",
      "frontend_origin": "https://app.tarjetas-integration.test",
      "session_domain": ".tarjetas-integration.test",
      "session_cookie": "tarjetas_integration_session",
      "environment_example": "backend.testing.env.example"
    },
    "browser": {
      "api_origin": "https://api.tarjetas-browser.test",
      "frontend_origin": "https://app.tarjetas-browser.test",
      "session_domain": ".tarjetas-browser.test",
      "session_cookie": "tarjetas_browser_session",
      "environment_example": "backend.browser-testing.env.example"
    }
  },
  "ingress_deadline": {
    "authority": "first_trusted_ingress",
    "start_event": "first_request_byte_before_any_body_buffering",
    "metadata_transport": "protected_fastcgi_parameters_or_authenticated_private_hop",
    "metadata_fields": [
      "request_id",
      "started_at_unix_ms",
      "deadline_unix_ms"
    ],
    "client_metadata_policy": "discard_and_replace",
    "edge_total_timer_required": true,
    "edge_upload_total_timer_required": true,
    "backend_may_reset_deadline": false,
    "direct_backend_bypass_allowed": false,
    "missing_or_invalid_metadata_status": 503,
    "clock_safety_margin_ms": 1000,
    "maximum_clock_skew_ms": 1000,
    "cancel_upstream_and_process_groups": true,
    "deadline_preserved_across_processing_hops": true,
    "read_timeout_is_total_deadline": false
  },
  "non_ocr_budget_accounting": {
    "limit_seconds": 180,
    "charged_phases": [
      "upload",
      "queue",
      "rendering",
      "verification",
      "persistence",
      "cleanup"
    ],
    "excluded_phase": "active_ocr_attempt_only",
    "pre_dispatch_enforcement": true,
    "propagate_trusted_cumulative_phase_context": true,
    "reset_between_hops_or_attempts": false,
    "expiry_wins_ties": true,
    "client_may_disable_guards": false,
    "outer_watchdog_fault_injection": "dedicated_test_harness_only"
  }
}
