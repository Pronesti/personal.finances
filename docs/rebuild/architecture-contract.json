{
  "version": 4,
  "date": "2026-11-04",
  "status": "plan_only_not_implemented",
  "backend": {
    "directory": "backend",
    "framework": "Laravel",
    "major": 13,
    "php": "8.5",
    "sanctum_major": 4,
    "api_prefix": "/api/v1",
    "independent_build_and_deployment": true
  },
  "frontend": {
    "directory": "frontend",
    "framework": "React",
    "release_line": "19.3",
    "language": "TypeScript",
    "bundler": "Vite",
    "bundler_release_line": "8.3",
    "node_lts_major": 24,
    "type": "standalone_spa",
    "api_base_env": "VITE_API_BASE_URL",
    "direct_http": true,
    "independent_build_and_deployment": true,
    "existing_financial_route_count": 32,
    "additional_routes": [
      "/login"
    ]
  },
  "prohibited": [
    "Inertia",
    "Blade application screens",
    "Laravel React starter kit",
    "Next.js runtime",
    "browser-stored authentication tokens"
  ],
  "authentication": {
    "mode": "sanctum_cookie_session",
    "csrf_cookie_path": "/sanctum/csrf-cookie",
    "csrf_header": "X-XSRF-TOKEN",
    "login": "/api/v1/auth/login",
    "current_user": "/api/v1/auth/user",
    "logout": "/api/v1/auth/logout",
    "with_credentials": true,
    "with_xsrf_token": true,
    "registration": "out_of_scope",
    "account_provisioning": "out_of_scope",
    "session_http_only": true,
    "session_secure": true,
    "session_same_site": "lax",
    "token_storage": [],
    "csrf_cookie_name": "XSRF-TOKEN"
  },
  "ownership": {
    "multiple_users": true,
    "one_private_ledger_per_user": true,
    "strategy": "shared_tables_with_ledger_id_and_composite_constraints",
    "ledger_from_authenticated_user": true,
    "client_owner_selection": false,
    "other_owner_resource_status": 404,
    "document_namespace": "ledgers/{ledger_uuid}/objects/{sha256}",
    "scope_caches_jobs_deduplication_and_commands": true,
    "baseline_schema_requires_extension": true,
    "eloquent_primary_key": "globally_unique_row_id_uuid",
    "logical_unique_key": [
      "ledger_id",
      "id"
    ],
    "shared_key_status": 200,
    "pending_namespace": "ledgers/{ledger_uuid}/pending/{pending_id}/{sha256}"
  },
  "local": {
    "frontend_origin": "https://app.tarjetas.test",
    "api_origin": "https://api.tarjetas.test",
    "api_base_url": "https://api.tarjetas.test/api/v1",
    "cors_allowed_origins": [
      "https://app.tarjetas.test"
    ],
    "sanctum_stateful_domains": [
      "app.tarjetas.test"
    ],
    "session_domain": ".tarjetas.test"
  },
  "health": {
    "method": "GET",
    "path": "/api/v1/health",
    "public": true,
    "expected_status": 200,
    "expected_json": {
      "status": "ok",
      "service": "tarjetas-api",
      "api_version": "v1"
    },
    "required_proof": "real_browser_request_from_frontend_to_api",
    "verification_status": "not_run_target_apps_not_implemented",
    "stateful_middleware": false,
    "session_middleware": false,
    "database_dependency": false,
    "sets_cookie": false,
    "cors_enabled": true,
    "browser_no_session_side_effects_required": true
