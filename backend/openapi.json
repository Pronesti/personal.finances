{
  "openapi": "3.1.0",
  "info": {
    "title": "Tarjetas API",
    "version": "1.0.0-foundation",
    "description": "Implemented foundation contract. Financial commands, pagination, optimistic versions and Idempotency-Key contracts must be specified before those consumers are introduced. Standard Laravel field validation uses HTTP 422 message/errors; domain errors use Error."
  },
  "servers": [
    {
      "url": "https://api.tarjetas.test"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "description": "Public liveness. No database, session, cookies or private storage. CORS remains enabled."
      }
    },
    "/sanctum/csrf-cookie": {
      "get": {
        "operationId": "csrfCookie",
        "security": [],
        "responses": {
          "204": {
            "description": "Session and readable XSRF-TOKEN cookie established"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "security": [
          {
            "csrf": []
          }
        ],
        "description": "Existing accounts only. Regenerates session ID. No token issuance or remember login. Five attempts per minute per IP/email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "Structured error",
            "content": {
              "application/json": {
