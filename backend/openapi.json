  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tarjetas_v1_session",
        "description": "Cookie name is environment specific. HttpOnly Secure SameSite=Lax."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN",
        "description": "Decoded readable XSRF-TOKEN cookie. Required on unsafe SPA requests."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message_key",
              "params"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message_key": {
                "type": "string"
              },
              "params": {
                "type": "object"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "api_version"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "tarjetas-api"
          },
          "api_version": {
            "const": "v1"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "ledger"
        ],
        "properties": {
          "user": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          },
          "ledger": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Bootstrap": {
        "type": "object",
        "required": [
          "cards",
          "catalog",
          "months",
          "documents"
        ],
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "catalog": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "months": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reference_id",
                "sha256",
                "byte_length"
              ],
              "properties": {
                "reference_id": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "byte_length": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
