    "/api/v1/bootstrap": {
      "get": {
        "operationId": "bootstrap",
        "description": "Owner-resolved metadata. Financial catalog and report months are added with the financial stage. Conflicting client owner fields are rejected.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bootstrap"
                }
              }
            }
          },
          "400": {
            "description": "Structured error",
            "content": {
