# Configuration template. Copy mappings into backend/.env.example during implementation.
# Credentials/absolute paths must be supplied for the actual installation.
APP_NAME=Tarjetas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.tarjetas.test
FRONTEND_URL=https://app.tarjetas.test
CORS_ALLOWED_ORIGINS=https://app.tarjetas.test
SANCTUM_STATEFUL_DOMAINS=app.tarjetas.test

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=tarjetas_v1_session
SESSION_DOMAIN=.tarjetas.test
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

TARJETAS_DOCUMENT_ROOT=
TARJETAS_REFERENCE_DIR=
TARJETAS_PYTHON=
TARJETAS_PDF_SCRIPT=
TARJETAS_OCR_SCRIPT=
TARJETAS_NODE_HELPER=
ACCOUNTING_APP_REVISION=
ANTHROPIC_API_KEY=

CACHE_STORE=file
QUEUE_CONNECTION=sync
TARJETAS_TEST_TARGET_ID=
TARJETAS_TEST_TARGET_REGISTRY=
TARJETAS_TEST_TEMP_ROOT=

# Trusted private ingress; never exposed to the SPA. Fail closed when absent.
TARJETAS_INGRESS_KEY=
TARJETAS_INGRESS_ROOT=
TARJETAS_PROCESSING_TEMP_ROOT=
